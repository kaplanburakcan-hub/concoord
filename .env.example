# ---- Genel ----
IPKS_ENV=development            # development | production
IPKS_HTTP_ADDR=:8080
IPKS_LOG_LEVEL=info             # debug | info | warn | error

# ---- PostgreSQL ----
POSTGRES_USER=ipks
POSTGRES_PASSWORD=degistir-bunu
POSTGRES_DB=ipks
IPKS_DB_DSN=postgres://ipks:degistir-bunu@postgres:5432/ipks?sslmode=disable

# ---- MinIO ----
MINIO_ROOT_USER=ipksminio
MINIO_ROOT_PASSWORD=degistir-bunu-uzun
IPKS_S3_ENDPOINT=minio:9000
# Presigned URL'lerde kullanılan istemci-erişilebilir uç nokta (boşsa IPKS_S3_ENDPOINT).
# Faz 2 indirmeleri API üzerinden akışla yapıldığından bu opsiyoneldir; ileride
# doğrudan tarayıcı presign akışına geçilirse public host buraya yazılır.
IPKS_S3_PUBLIC_ENDPOINT=
IPKS_S3_ACCESS_KEY=ipksminio
IPKS_S3_SECRET_KEY=degistir-bunu-uzun
IPKS_S3_BUCKET=ipks
IPKS_S3_REGION=us-east-1
IPKS_S3_USE_SSL=false

# ---- Offsite yedek hedefi (S3 uyumlu, VPS'ten AYRI sağlayıcı) ----
OFFSITE_S3_ENDPOINT=https://ornek-offsite-s3.example.com
OFFSITE_S3_ACCESS_KEY=
OFFSITE_S3_SECRET_KEY=
OFFSITE_S3_BUCKET=ipks-backup

# ---- Faz 1: Kimlik & Yetki ----
# Access token imza anahtarı. Production'da ZORUNLU (uzun, rastgele üretin):
#   openssl rand -base64 48
IPKS_JWT_SECRET=gelistirme-icin-guvensiz-degistir
IPKS_ACCESS_TTL=15m
IPKS_REFRESH_TTL=720h
IPKS_RESET_TTL=1h

# İlk açılışta idempotent oluşturulan platform yöneticisi.
# Parola boşsa seed rastgele üretir ve LOG'a yazar (yalnızca dev; prod'da doldurun).
IPKS_BOOTSTRAP_ADMIN_EMAIL=admin@ipks.local
IPKS_BOOTSTRAP_ADMIN_PASSWORD=

# ---- Prod / VPS ----
DOMAIN=ipks.example.com
LETSENCRYPT_EMAIL=admin@example.com

# ---- Faz 4: Bildirim motoru ----
# SMTP boş bırakılırsa e-postalar gönderilmez, yalnızca worker log'una yazılır (dev).
IPKS_SMTP_HOST=
IPKS_SMTP_PORT=587
IPKS_SMTP_USER=
IPKS_SMTP_PASS=
IPKS_SMTP_FROM=ipks@example.com

# SMS sağlayıcı: "netgsm" ya da boş (log adaptörü — gönderim yapılmaz).
# İleti Merkezi vb. için internal/notify/sms.go'ya yeni adaptör eklenir.
IPKS_SMS_PROVIDER=
IPKS_SMS_API_URL=
IPKS_SMS_USER=
IPKS_SMS_PASS=
IPKS_SMS_HEADER=

# ---- Faz 10: Sertleştirme ve yayına alma ----
# CORS: virgülle ayrılmış izinli origin listesi. Aynı-origin dağıtımda (nginx
# arkasında frontend + API tek host) BOŞ bırakın. Joker (*) desteklenmez.
IPKS_CORS_ORIGINS=

# İstek hız sınırı (IP başına token-bucket). RPS=dolum hızı, BURST=kapasite.
# 0 → kapalı. Yük testinde geçici yükseltmeniz gerekebilir (bkz. deploy/loadtest).
IPKS_RATE_LIMIT_RPS=20
IPKS_RATE_LIMIT_BURST=40

# Kimlik uçları (login/refresh/forgot/reset) için IP başına dakikalık deneme
# sınırı (kaba kuvvete karşı). 0 → kapalı.
IPKS_LOGIN_RATE_LIMIT=10

# Antivirüs (opsiyonel): clamd TCP adresi (host:port). Boşsa yükleme taraması
# atlanır (tip/uzantı doğrulaması yine uygulanır). Açıkken clamd erişilemezse
# yükleme reddedilir (fail-closed).
IPKS_CLAMD_ADDR=

# Prod hata bildirimi (opsiyonel): 5xx/panik olaylarını gönderen webhook URL'i
# (Slack/Teams uyumlu {"text": "..."}). Boşsa yalnızca loglanır.
IPKS_ERROR_WEBHOOK_URL=
